# Скопировать в .env и подставить свои значения
# .env читается docker-compose автоматически

# Telegram Bot API token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Опционально — переопределение pipeline-параметров через env
# (по умолчанию в docker-compose.yml уже выставлены REPORT3 + RAW_FLOOR=0.003)
# MAXP_PER_DEPT=on
# CE_FINAL_LIMIT=10
# RAW_FLOOR=0.003       # 0.003 — золотая середина, 0.005 — строгий OOS, -999 — off
